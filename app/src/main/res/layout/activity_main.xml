<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/ime_name"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="Enable and select the keyboard to start typing in Bangla!"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btn_enable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="1. Enable Keyboard" />

        <Button
            android:id="@+id/btn_select"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="2. Select Keyboard" />

        <Button
            android:id="@+id/btn_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Keyboard Settings" />

        <EditText
            android:id="@+id/et_test"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:hint="Test typing here..."
            android:padding="12dp"
            android:background="@android:drawable/editbox_background" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="32dp"
            android:background="?android:attr/dividerVertical" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="How to Type Bangla"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Phonetic Section -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Phonetic Mode (Easy)"
                    android:textColor="?android:attr/colorPrimary"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Type as it sounds in English. It automatically converts to Bangla." />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="• 'amar' → আমার\n• 'bangla' → বাংলা\n• 'rohomon' → রহমান\n• 'O' (Shift+o) → অ\n• 'a' or 'A' → আ"
                    android:textStyle="italic" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Special Marks"
                    android:textColor="?android:attr/colorPrimary"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="14sp"
                    android:text="^ (Shift+6) = ঁ (Chandrabindu)\nNG (Shift+ng) = ং (Anusvara)\n: = ঃ (Visarga)" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Layout Section -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Probhat Layout Mode"
                    android:textColor="?android:attr/colorPrimary"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="A fixed layout where each key represents a specific Bangla character." />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="• 'f' → া  |  Shift+'f' → অ\n• 'a' → ু  |  Shift+'a' → ূ\n• 's' → ৃ  |  Shift+'s' → ষ\n• 'v' → র  |  Shift+'v' → ভ"
                    android:textStyle="italic" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Special Marks"
                    android:textColor="?android:attr/colorPrimary"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="14sp"
                    android:text="^ (Shift+6) = ঁ (Chandrabindu)\nNG (Shift+ng) = ং (Anusvara)\n: = ঃ (Visarga)" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Phonetic Key Mapping Reference"
            android:textSize="20sp"
            android:textStyle="bold" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Vowels &amp; Signs"
                    android:textColor="?android:attr/colorPrimary"
                    android:textStyle="bold" />

                <TableLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:stretchColumns="1">

                    <TableRow>
                        <TextView android:text="a, A" android:textStyle="bold" android:paddingRight="16dp"/>
                        <TextView android:text="আ (া)" />
                    </TableRow>
                    <TableRow>
                        <TextView android:text="i" android:textStyle="bold" />
                        <TextView android:text="ই (ি)" />
                    </TableRow>
                    <TableRow>
                        <TextView android:text="I (Shift+i)" android:textStyle="bold" />
                        <TextView android:text="ঈ (ী)" />
                    </TableRow>
                    <TableRow>
                        <TextView android:text="u" android:textStyle="bold" />
                        <TextView android:text="উ (ু)" />
                    </TableRow>
                    <TableRow>
                        <TextView android:text="U (Shift+u)" android:textStyle="bold" />
                        <TextView android:text="ঊ (ূ)" />
                    </TableRow>
                    <TableRow>
                        <TextView android:text="e, E" android:textStyle="bold" />
                        <TextView android:text="এ (ে)" />
                    </TableRow>
                    <TableRow>
                        <TextView android:text="o" android:textStyle="bold" />
                        <TextView android:text="ও" />
                    </TableRow>
                    <TableRow>
                        <TextView android:text="O (Shift+o)" android:textStyle="bold" />
                        <TextView android:text="অ (ো)" />
                    </TableRow>
                </TableLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Consonants (Common)"
                    android:textColor="?android:attr/colorPrimary"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="14sp"
                    android:text="k=ক, g=গ, c/ch=চ, j=জ, t=ত, T=ট, d=দ, D=ড, n=ন, N=ণ, p=প, b=ব, m=ম, r=র, l=ল, s=স, sh=শ, ss=ষ, h=হ" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Special Consonants"
                    android:textColor="?android:attr/colorPrimary"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="14sp"
                    android:text="kh=খ, gh=ঘ, chh=ছ, jh=ঝ, th=ত, Th=ঠ, dh=দ, Dh=ঢ, ph/f=ফ, bh/v=ভ, y=য়, w=ওয়, ng=ঙ, ksh=ক্ষ" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Special Marks"
                    android:textColor="?android:attr/colorPrimary"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="14sp"
                    android:text="^ (Shift+6) = ঁ (Chandrabindu)\nNG (Shift+ng) = ং (Anusvara)\n: = ঃ (Visarga)" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Complex &amp; Combined Characters"
            android:textSize="20sp"
            android:textStyle="bold" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Phonetic Conjuncts"
                    android:textColor="?android:attr/colorPrimary"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Simply type the consonants together. The engine will automatically form the conjunct." />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="• 'kk' → ক্ক\n• 'kt' → ক্ত\n• 'bd' → ব্দ\n• 'nd' → ন্দ\n• 'shonim' → শনিম\n• 'proshno' → প্রশ্ন (p+r+o+sh+n+o)"
                    android:textStyle="italic" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Special Rules:"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• 'r' + consonant → Reph (র্)\n  e.g., 'rka' → রকা (or র্ক if followed by vowel)\n• consonant + 'y' → Jafala (্য)\n  e.g., 'ky' → ক্য\n• 'ksh' → ক্ষ"
                    android:textSize="14sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Special Marks"
                    android:textColor="?android:attr/colorPrimary"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="14sp"
                    android:text="^ (Shift+6) = ঁ (Chandrabindu)\nNG (Shift+ng) = ং (Anusvara)\n: = ঃ (Visarga)" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Layout Conjuncts (The 'g' key)"
                    android:textColor="?android:attr/colorPrimary"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="In Layout mode, use the 'g' key (্) to join two consonants." />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Example for 'ক্ত' (k+t):\n1. Press 'j' (ক)\n2. Press 'g' (্)\n3. Press 'k' (ত)"
                    android:textStyle="italic" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Example for 'প্র' (p+r):\n1. Press 'r' (প)\n2. Press 'g' (্)\n3. Press 'v' (র)"
                    android:textStyle="italic" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Special Marks"
                    android:textColor="?android:attr/colorPrimary"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="14sp"
                    android:text="^ (Shift+6) = ঁ (Chandrabindu)\nNG (Shift+ng) = ং (Anusvara)\n: = ঃ (Visarga)" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Tips Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Quick Tips"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="• Tap the globe (🌐) icon to switch languages.\n• Tap '?123' for symbols and punctuation.\n• Numbers row is available at the top for easy access." />

        <Space
            android:layout_width="match_parent"
            android:layout_height="32dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
