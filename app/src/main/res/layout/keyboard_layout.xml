<?xml version="1.0" encoding="utf-8"?>
<com.keyboard.ime.KeyboardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/keyboard_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_keyboard"
    android:orientation="vertical"
    android:padding="4dp">

    <!-- Toolbar row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="#121212"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/key_copy"
            style="@style/KeyboardKey.Function"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:src="@drawable/ic_copy"
            android:scaleType="centerInside"
            android:padding="12dp"
            android:background="?android:attr/selectableItemBackground" />

        <ImageButton
            android:id="@+id/key_paste"
            style="@style/KeyboardKey.Function"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:src="@drawable/ic_paste"
            android:scaleType="centerInside"
            android:padding="12dp"
            android:background="?android:attr/selectableItemBackground" />

        <ImageButton
            android:id="@+id/key_emoji"
            style="@style/KeyboardKey.Function"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:src="@drawable/ic_emoji"
            android:scaleType="centerInside"
            android:padding="12dp"
            android:background="?android:attr/selectableItemBackground" />

        <View
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:layout_gravity="center_vertical"
            android:background="#444444" />

        <com.keyboard.ui.CandidateView
            android:id="@+id/candidate_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="4dp"
            android:paddingEnd="4dp" />
    </LinearLayout>

    <!-- Main Keyboard Area -->
    <LinearLayout
        android:id="@+id/keyboard_rows_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="visible">

        <!-- Number row -->
        <LinearLayout
            android:id="@+id/row_numbers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button android:id="@+id/key_1" style="@style/KeyboardKey" android:text="1" />
            <Button android:id="@+id/key_2" style="@style/KeyboardKey" android:text="2" />
            <Button android:id="@+id/key_3" style="@style/KeyboardKey" android:text="3" />
            <Button android:id="@+id/key_4" style="@style/KeyboardKey" android:text="4" />
            <Button android:id="@+id/key_5" style="@style/KeyboardKey" android:text="5" />
            <Button android:id="@+id/key_6" style="@style/KeyboardKey" android:text="6" />
            <Button android:id="@+id/key_7" style="@style/KeyboardKey" android:text="7" />
            <Button android:id="@+id/key_8" style="@style/KeyboardKey" android:text="8" />
            <Button android:id="@+id/key_9" style="@style/KeyboardKey" android:text="9" />
            <Button android:id="@+id/key_0" style="@style/KeyboardKey" android:text="0" />
        </LinearLayout>

        <!-- QWERTY row 1 -->
        <LinearLayout
            android:id="@+id/row_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button android:id="@+id/key_q" style="@style/KeyboardKey" android:text="q" />
            <Button android:id="@+id/key_w" style="@style/KeyboardKey" android:text="w" />
            <Button android:id="@+id/key_e" style="@style/KeyboardKey" android:text="e" />
            <Button android:id="@+id/key_r" style="@style/KeyboardKey" android:text="r" />
            <Button android:id="@+id/key_t" style="@style/KeyboardKey" android:text="t" />
            <Button android:id="@+id/key_y" style="@style/KeyboardKey" android:text="y" />
            <Button android:id="@+id/key_u" style="@style/KeyboardKey" android:text="u" />
            <Button android:id="@+id/key_i" style="@style/KeyboardKey" android:text="i" />
            <Button android:id="@+id/key_o" style="@style/KeyboardKey" android:text="o" />
            <Button android:id="@+id/key_p" style="@style/KeyboardKey" android:text="p" />
        </LinearLayout>

        <!-- QWERTY row 2 -->
        <LinearLayout
            android:id="@+id/row_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <Button android:id="@+id/key_a" style="@style/KeyboardKey" android:text="a" />
            <Button android:id="@+id/key_s" style="@style/KeyboardKey" android:text="s" />
            <Button android:id="@+id/key_d" style="@style/KeyboardKey" android:text="d" />
            <Button android:id="@+id/key_f" style="@style/KeyboardKey" android:text="f" />
            <Button android:id="@+id/key_g" style="@style/KeyboardKey" android:text="g" />
            <Button android:id="@+id/key_h" style="@style/KeyboardKey" android:text="h" />
            <Button android:id="@+id/key_j" style="@style/KeyboardKey" android:text="j" />
            <Button android:id="@+id/key_k" style="@style/KeyboardKey" android:text="k" />
            <Button android:id="@+id/key_l" style="@style/KeyboardKey" android:text="l" />
        </LinearLayout>

        <!-- QWERTY row 3 -->
        <LinearLayout
            android:id="@+id/row_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/key_shift"
                style="@style/KeyboardKey.Function"
                android:layout_width="52dp"
                android:text="⇧"
                android:textStyle="bold" />

            <Button android:id="@+id/key_z" style="@style/KeyboardKey" android:text="z" />
            <Button android:id="@+id/key_x" style="@style/KeyboardKey" android:text="x" />
            <Button android:id="@+id/key_c" style="@style/KeyboardKey" android:text="c" />
            <Button android:id="@+id/key_v" style="@style/KeyboardKey" android:text="v" />
            <Button android:id="@+id/key_b" style="@style/KeyboardKey" android:text="b" />
            <Button android:id="@+id/key_n" style="@style/KeyboardKey" android:text="n" />
            <Button android:id="@+id/key_m" style="@style/KeyboardKey" android:text="m" />

            <Button
                android:id="@+id/key_backspace"
                style="@style/KeyboardKey.Function"
                android:layout_width="52dp"
                android:text="⌫" />
        </LinearLayout>

        <!-- Bottom row -->
        <LinearLayout
            android:id="@+id/row_bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/key_symbols"
                style="@style/KeyboardKey.Function"
                android:layout_width="48dp"
                android:text="\\?123"
                android:textSize="11sp" />

            <Button
                android:id="@+id/key_language"
                style="@style/KeyboardKey.Function"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="🌐"
                android:textSize="14sp" />

            <Button
                android:id="@+id/key_comma"
                style="@style/KeyboardKey"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_key_tutorial"
                android:text="," />

            <Button
                android:id="@+id/key_space"
                style="@style/KeyboardKey.Space"
                android:layout_width="0dp"
                android:layout_weight="3"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text=" " />

            <Button
                android:id="@+id/key_period"
                style="@style/KeyboardKey"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="." />

            <Button
                android:id="@+id/key_enter"
                style="@style/KeyboardKey.Function"
                android:layout_width="56dp"
                android:text="↵"
                android:textSize="18sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Emoji Picker Area -->
    <LinearLayout
        android:id="@+id/emoji_picker_container"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:orientation="vertical"
        android:visibility="gone"
        android:background="#1A1A1A">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="4dp">

            <View
                android:layout_width="48dp"
                android:layout_height="40dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Emojis"
                android:textColor="#FFFFFF"
                android:gravity="center" />

            <ImageButton
                android:id="@+id/btn_emoji_backspace"
                android:layout_width="48dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_backspace"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:scaleType="centerInside" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/emoji_recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </LinearLayout>

</com.keyboard.ime.KeyboardView>
