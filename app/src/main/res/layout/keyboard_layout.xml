<?xml version="1.0" encoding="utf-8"?>
<com.keyboard.ime.KeyboardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/keyboard_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_keyboard"
    android:orientation="vertical"
    android:padding="4dp">

    <!-- Suggestions row -->
    <com.keyboard.ui.CandidateView
        android:id="@+id/candidate_view"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:background="#121212" />

    <!-- Number row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/key_1"
            style="@style/KeyboardKey"
            android:text="1" />

        <Button
            android:id="@+id/key_2"
            style="@style/KeyboardKey"
            android:text="2" />

        <Button
            android:id="@+id/key_3"
            style="@style/KeyboardKey"
            android:text="3" />

        <Button
            android:id="@+id/key_4"
            style="@style/KeyboardKey"
            android:text="4" />

        <Button
            android:id="@+id/key_5"
            style="@style/KeyboardKey"
            android:text="5" />

        <Button
            android:id="@+id/key_6"
            style="@style/KeyboardKey"
            android:text="6" />

        <Button
            android:id="@+id/key_7"
            style="@style/KeyboardKey"
            android:text="7" />

        <Button
            android:id="@+id/key_8"
            style="@style/KeyboardKey"
            android:text="8" />

        <Button
            android:id="@+id/key_9"
            style="@style/KeyboardKey"
            android:text="9" />

        <Button
            android:id="@+id/key_0"
            style="@style/KeyboardKey"
            android:text="0" />
    </LinearLayout>

    <!-- QWERTY row 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/key_q"
            style="@style/KeyboardKey"
            android:text="q" />

        <Button
            android:id="@+id/key_w"
            style="@style/KeyboardKey"
            android:text="w" />

        <Button
            android:id="@+id/key_e"
            style="@style/KeyboardKey"
            android:text="e" />

        <Button
            android:id="@+id/key_r"
            style="@style/KeyboardKey"
            android:text="r" />

        <Button
            android:id="@+id/key_t"
            style="@style/KeyboardKey"
            android:text="t" />

        <Button
            android:id="@+id/key_y"
            style="@style/KeyboardKey"
            android:text="y" />

        <Button
            android:id="@+id/key_u"
            style="@style/KeyboardKey"
            android:text="u" />

        <Button
            android:id="@+id/key_i"
            style="@style/KeyboardKey"
            android:text="i" />

        <Button
            android:id="@+id/key_o"
            style="@style/KeyboardKey"
            android:text="o" />

        <Button
            android:id="@+id/key_p"
            style="@style/KeyboardKey"
            android:text="p" />
    </LinearLayout>

    <!-- QWERTY row 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <Button
            android:id="@+id/key_a"
            style="@style/KeyboardKey"
            android:text="a" />

        <Button
            android:id="@+id/key_s"
            style="@style/KeyboardKey"
            android:text="s" />

        <Button
            android:id="@+id/key_d"
            style="@style/KeyboardKey"
            android:text="d" />

        <Button
            android:id="@+id/key_f"
            style="@style/KeyboardKey"
            android:text="f" />

        <Button
            android:id="@+id/key_g"
            style="@style/KeyboardKey"
            android:text="g" />

        <Button
            android:id="@+id/key_h"
            style="@style/KeyboardKey"
            android:text="h" />

        <Button
            android:id="@+id/key_j"
            style="@style/KeyboardKey"
            android:text="j" />

        <Button
            android:id="@+id/key_k"
            style="@style/KeyboardKey"
            android:text="k" />

        <Button
            android:id="@+id/key_l"
            style="@style/KeyboardKey"
            android:text="l" />
    </LinearLayout>

    <!-- QWERTY row 3 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/key_shift"
            style="@style/KeyboardKey.Function"
            android:layout_width="52dp"
            android:text="⇧"
            android:textStyle="bold" />

        <Button
            android:id="@+id/key_z"
            style="@style/KeyboardKey"
            android:text="z" />

        <Button
            android:id="@+id/key_x"
            style="@style/KeyboardKey"
            android:text="x" />

        <Button
            android:id="@+id/key_c"
            style="@style/KeyboardKey"
            android:text="c" />

        <Button
            android:id="@+id/key_v"
            style="@style/KeyboardKey"
            android:text="v" />

        <Button
            android:id="@+id/key_b"
            style="@style/KeyboardKey"
            android:text="b" />

        <Button
            android:id="@+id/key_n"
            style="@style/KeyboardKey"
            android:text="n" />

        <Button
            android:id="@+id/key_m"
            style="@style/KeyboardKey"
            android:text="m" />

        <Button
            android:id="@+id/key_backspace"
            style="@style/KeyboardKey.Function"
            android:layout_width="52dp"
            android:text="⌫" />
    </LinearLayout>

    <!-- Bottom row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/key_symbols"
            style="@style/KeyboardKey.Function"
            android:layout_width="48dp"
            android:text="\?123"
            android:textSize="11sp" />

        <Button
            android:id="@+id/key_language"
            style="@style/KeyboardKey.Function"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="🌐"
            android:textSize="14sp" />

        <Button
            android:id="@+id/key_comma"
            style="@style/KeyboardKey"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="," />

        <Button
            android:id="@+id/key_space"
            style="@style/KeyboardKey.Space"
            android:layout_width="0dp"
            android:layout_weight="3"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text=" " />

        <Button
            android:id="@+id/key_period"
            style="@style/KeyboardKey"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="." />

        <Button
            android:id="@+id/key_enter"
            style="@style/KeyboardKey.Function"
            android:layout_width="56dp"
            android:text="↵"
            android:textSize="18sp" />
    </LinearLayout>

</com.keyboard.ime.KeyboardView>
