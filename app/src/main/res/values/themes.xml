<resources>
    <style name="Theme.Keyboard" parent="Theme.Material3.DayNight.NoActionBar" />

    <!-- Keyboard Key Styles -->
    <style name="KeyboardKey">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:background">@drawable/bg_key</item>
        <item name="android:gravity">center</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:padding">0dp</item>
    </style>

    <style name="KeyboardKey.Function">
        <item name="android:background">@drawable/bg_key_function</item>
        <item name="android:layout_weight">0</item>
    </style>

    <style name="KeyboardKey.Space">
        <item name="android:layout_weight">1</item>
    </style>
</resources>
